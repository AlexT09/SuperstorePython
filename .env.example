# Configuración del Asistente IA. Copia este archivo como .env y pon tu clave (nunca subas el .env).
# Clave gratuita de Google Gemini: https://aistudio.google.com -> Get API key
OPENAI_API_KEY=pega_aqui_tu_clave
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash

# Otros proveedores compatibles (cambia las tres líneas):
#   Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenAI: borra OPENAI_BASE_URL y usa tu clave de platform.openai.com
#   Ollama: OPENAI_BASE_URL=http://localhost:11434/v1  y  OPENAI_API_KEY=ollama
